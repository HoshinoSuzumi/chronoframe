{
  "name": "chronoframe",
  "version": "1.0.2",
  "author": {
    "name": "ChronoFrame",
    "email": "master@uniiem.com"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "scripts": {
    "db": "drizzle-kit",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio --port 3010",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate-database.ts",
    "build": "node scripts/self-hosted.mjs build",
    "build:deps": "pnpm --filter @chronoframe/storage build && pnpm --filter @chronoframe/webgl-image build",
    "dev": "run-p dev:dep dev:wait-only",
    "dev:dep": "pnpm --filter @chronoframe/webgl-image dev",
    "dev:only": "node scripts/self-hosted.mjs dev",
    "dev:wait-only": "wait-on packages/webgl-image/dist && node scripts/self-hosted.mjs dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "node scripts/self-hosted.mjs generate",
    "preview": "node scripts/self-hosted.mjs preview",
    "postinstall": "node scripts/self-hosted.mjs prepare",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:packages": "node scripts/check-ui-boundaries.mjs && node scripts/check-package-boundaries.mjs && pnpm --filter @chronoframe/worker --filter @chronoframe/jobs --filter @chronoframe/processing --filter @chronoframe/database --filter @chronoframe/platform --filter @chronoframe/core --filter @chronoframe/contracts --filter @chronoframe/storage --filter @chronoframe/media --filter @chronoframe/geocoding type-check",
    "test": "node --experimental-strip-types --test tests/*.test.ts packages/gallery/app/utils/*.test.ts",
    "check:ui": "node scripts/check-ui-boundaries.mjs",
    "prepare": "node scripts/self-hosted.mjs prepare",
    "dev:cloud": "node scripts/saas-entry.mjs cloud dev",
    "build:cloud": "node scripts/saas-entry.mjs cloud build",
    "prepare:cloud": "node scripts/saas-entry.mjs cloud prepare",
    "dev:site": "node scripts/saas-entry.mjs site dev",
    "build:site": "node scripts/saas-entry.mjs site build",
    "prepare:site": "node scripts/saas-entry.mjs site prepare",
    "check:entries": "node scripts/check-entry-boundaries.mjs",
    "smoke:cloud": "node scripts/smoke-edge-entry.mjs cloud",
    "smoke:site": "node scripts/smoke-edge-entry.mjs site"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@chronoframe/contracts": "workspace:*",
    "@chronoframe/webgl-image": "workspace:*",
    "@iconify/vue": "5.0.4",
    "@indoorequal/vue-maplibre-gl": "^8.4.2",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.6.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "@takumi-rs/core": "2.17.1",
    "@unhead/vue": "^2.1.17",
    "@vingle/bmp-js": "^0.2.5",
    "@vueuse/nuxt": "14.4.0",
    "@yeger/vue-masonry-wall": "^6.1.4",
    "better-sqlite3": "^12.11.1",
    "dayjs-nuxt": "2.1.11",
    "driver.js": "^1.10.2",
    "drizzle-orm": "^0.45.4",
    "es-toolkit": "^1.53.0",
    "exiftool-vendored": "^35.21.0",
    "file-type": "^22.2.0",
    "h3": "1.15.11",
    "heic-convert": "^2.1.0",
    "maplibre-gl": "^5.24.0",
    "motion-v": "^2.8.0",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "0.5.32",
    "nuxt-gtag": "4.1.0",
    "nuxt-mapbox": "1.6.4",
    "nuxt-maplibre": "^1.2.2",
    "nuxt-og-image": "6.10.4",
    "pinia": "^3.0.4",
    "reka-ui": "^2.11.0",
    "sharp": "^0.35.5",
    "swiper": "^12.2.0",
    "systeminformation": "^5.33.16",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "thumbhash": "^0.1.1",
    "tippy.js": "^6.3.7",
    "unstorage": "^1.17.6",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "wait-on": "^9.5.1",
    "zod": "^4.6.7",
    "@chronoframe/storage": "workspace:*",
    "@chronoframe/media": "workspace:*",
    "@chronoframe/geocoding": "workspace:*",
    "@chronoframe/core": "workspace:*",
    "@chronoframe/database": "workspace:*",
    "@chronoframe/jobs": "workspace:*",
    "@chronoframe/processing": "workspace:*",
    "@chronoframe/gallery": "workspace:*",
    "@chronoframe/console": "workspace:*",
    "@nuxtjs/color-mode": "4.0.1",
    "nuxt-site-config": "4.2.3"
  },
  "packageManager": "pnpm@10.34.8",
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.29",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/material-symbols": "^1.2.96",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/streamline": "^1.2.5",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify-json/tabler": "^1.2.42",
    "@nuxt/test-utils": "4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/heic-convert": "^2.1.1",
    "@vueuse/core": "^14.4.0",
    "baseline-browser-mapping": "^2.11.32",
    "consola": "^3.4.2",
    "dayjs": "^1.11.23",
    "drizzle-kit": "^0.31.11",
    "mapbox-gl": "^3.33.0",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "sass-embedded": "^1.106.1",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.20",
    "wrangler": "4.152.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@nuxt/kit"
      ]
    },
    "overrides": {
      "sharp": "0.35.5"
    },
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild",
      "unrs-resolver",
      "vue-demi"
    ],
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp"
    ]
  }
}
