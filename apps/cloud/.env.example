# App-local configuration; the root Self-hosted .env is not loaded.
# NUXT_SESSION_PASSWORD=replace-with-a-unique-secret-of-at-least-32-characters

# Platform runtime configuration. Email sign-in also requires migrated D1.
# NUXT_PLATFORM_PORTAL_ORIGIN=https://app.chronoframe.art
# NUXT_PLATFORM_SECRET=use-an-independent-random-secret-of-at-least-32-bytes
# Optional legacy verification sender fallback. D1 mail templates take precedence.
# NUXT_PLATFORM_EMAIL_FROM=verify@noreply.chronoframe.art
# EMAIL is a Cloudflare Email Sending send_email binding, not an API key.
# DB is a D1 binding, not a string environment variable.
# The deploy workflow reads PLATFORM_D1_DATABASE_ID from GitHub Environment variables.
# PLATFORM_EMAIL_FROM is optional; business senders are configured in D1.
# The EMAIL binding must allow those verified senders. No mail provider key is needed.

# Independent app secret for production OG image signing (at least 32 characters).
# Configure as a Worker secret binding in production; do not reuse platform/session keys.
# Optional stable local app secret; otherwise Nuxt generates a development app secret.
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# See README.md: Local portal development. Preserve an existing valid value.
# NUXT_APP_SECRET=replace-with-an-independent-random-secret
